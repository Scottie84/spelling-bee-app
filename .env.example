# Copy this file to `.env` and fill in your real values.

# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Supabase — public project URL + publishable/anon key (safe in the client;
# the database is protected by Row Level Security). Find them in
# Supabase → Project Settings → API. Leave blank to use local IndexedDB only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
